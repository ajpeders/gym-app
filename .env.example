# Domain Traefik routes this app on
GYM_DOMAIN=gym.thelunadog.com
# Secret for signing JWTs (generate a long random string)
GYM_JWT_SECRET=change-me-to-a-long-random-string
# CORS. `*` is safe here only because auth is a Bearer JWT, not a cookie —
# a wildcard origin cannot be used to ride an ambient session. Narrow it if
# you ever move to cookie auth.
GYM_CORS_ORIGINS=*
# Set false to refuse new signups (both /api/auth/register and first-time
# OAuth) while existing accounts still work. Open by default; the public
# instance relies on the gym-auth-limit rate limit rather than this flag.
GYM_ALLOW_REGISTRATION=true
# --- future AI (unused in Phase 1) ---
GYM_OLLAMA_URL=http://192.168.0.40:11434
GYM_CLAUDE_API_KEY=
